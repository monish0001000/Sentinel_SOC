<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.1</Version>
    <Company>Sentinel SOC</Company>
    <Product>Sentinel Windows Endpoint Agent Installer</Product>
    <AssemblyName>SentinelAgentSetup</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sentinel.Agent.Core\Sentinel.Agent.Core.csproj" />
  </ItemGroup>

  <!-- Embedded self-contained Service EXE payload when built for release -->
  <ItemGroup Condition="Exists('Payload\Sentinel.Agent.Service.exe')">
    <EmbeddedResource Include="Payload\Sentinel.Agent.Service.exe" LogicalName="Sentinel.Agent.Service.exe" />
  </ItemGroup>
</Project>
