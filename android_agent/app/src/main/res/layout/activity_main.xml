<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1220"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Sentinel SOC Android Agent (v1.0.3)"
            android:textColor="#F8FAFC"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Real OS Telemetry, Posture Alerts &amp; Remote Command Sync"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#111C33"
            android:padding="12dp"
            android:text="TRANSPARENCY &amp; PERMISSIONS:\n• Collects: Device model, Android OS/SDK, CPU load/freq, RAM, Storage, Uptime, Network TX/RX rates, VPN state, ADB/LockScreen posture, and socket metadata where kernel SELinux permits.\n• NEVER Collects: SMS, call logs, contacts, photos, GPS location, passwords, or decrypted packet payloads."
            android:textColor="#CBD5E1"
            android:textSize="12sp" />

        <CheckBox
            android:id="@+id/checkConsent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="I understand what telemetry is collected and authorize running Sentinel SOC Agent."
            android:textColor="#E2E8F0"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnImportJson"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Import JSON" />

            <Space
                android:layout_width="8dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnValidate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Validate Bundle" />
        </LinearLayout>

        <EditText
            android:id="@+id/inputBundleJson"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="8dp"
            android:background="#111C33"
            android:gravity="top|start"
            android:hint="Paste Enrollment Bundle JSON from Web Console → Connect Endpoint..."
            android:inputType="textMultiLine"
            android:padding="10dp"
            android:textColor="#F1F5F9"
            android:textColorHint="#64748B"
            android:textSize="12sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/textValidation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Paste or import sentinel-enrollment.json to enroll."
            android:textColor="#38BDF8"
            android:textSize="12sp" />

        <Button
            android:id="@+id/btnEnrollStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Enroll &amp; Start Agent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSyncNow"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Sync Now" />

            <Space
                android:layout_width="6dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnStopService"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Stop" />

            <Space
                android:layout_width="6dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnUnenroll"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Unenroll" />
        </LinearLayout>

        <TextView
            android:id="@+id/textStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#0F172A"
            android:padding="10dp"
            android:text="Status: Idle"
            android:textColor="#10B981"
            android:textSize="12sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/textLogs"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="8dp"
            android:background="#070D19"
            android:padding="10dp"
            android:text="Waiting for agent activity..."
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:typeface="monospace" />

    </LinearLayout>
</ScrollView>
